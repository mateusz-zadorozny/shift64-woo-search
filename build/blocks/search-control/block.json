{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shift64-woo-search/search-control",
  "version": "0.1.0",
  "title": "Search Control",
  "category": "widgets",
  "icon": "search",
  "description": "The closed search control or modal trigger.",
  "textdomain": "shift64-woo-search",
  "parent": [
    "shift64-woo-search/search",
    "shift64-woo-search/modal-search"
  ],
  "ancestor": [
    "shift64-woo-search/search",
    "shift64-woo-search/modal-search"
  ],
  "usesContext": [
    "shift64WooSearch/instanceId",
    "shift64WooSearch/runtimeId",
    "shift64WooSearch/variant"
  ],
  "attributes": {
    "label": {
      "type": "string"
    },
    "placeholder": {
      "type": "string"
    },
    "submitLabel": {
      "type": "string"
    },
    "triggerLabel": {
      "type": "string"
    },
    "triggerIcon": {
      "type": "string",
      "enum": [
        "none",
        "search"
      ],
      "default": "search"
    },
    "triggerIconColor": {
      "type": "string"
    },
    "triggerIconHoverColor": {
      "type": "string"
    },
    "triggerBackgroundColor": {
      "type": "string"
    },
    "triggerBackgroundHoverColor": {
      "type": "string"
    },
    "buttonTextColor": {
      "type": "string"
    },
    "buttonTextHoverColor": {
      "type": "string"
    },
    "buttonBackgroundColor": {
      "type": "string"
    },
    "buttonBackgroundHoverColor": {
      "type": "string"
    },
    "inputTextColor": {
      "type": "string"
    },
    "inputBackgroundColor": {
      "type": "string"
    },
    "inputRadius": {
      "type": "number"
    },
    "buttonRadius": {
      "type": "number"
    },
    "inputPaddingX": {
      "type": "number"
    },
    "inputPaddingY": {
      "type": "number"
    },
    "buttonPaddingX": {
      "type": "number"
    },
    "buttonPaddingY": {
      "type": "number"
    },
    "fieldGap": {
      "type": "number"
    },
    "joined": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "html": false,
    "inserter": false,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css"
}