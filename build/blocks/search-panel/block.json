{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shift64-woo-search/search-panel",
  "version": "0.1.0",
  "title": "Search Panel",
  "category": "widgets",
  "icon": "list-view",
  "description": "The suggestion tray or open search dialog.",
  "textdomain": "shift64-woo-search",
  "parent": [
    "shift64-woo-search/search",
    "shift64-woo-search/modal-search"
  ],
  "ancestor": [
    "shift64-woo-search/search",
    "shift64-woo-search/modal-search"
  ],
  "usesContext": [
    "shift64WooSearch/instanceId",
    "shift64WooSearch/runtimeId",
    "shift64WooSearch/variant",
    "shift64WooSearch/previewOpen"
  ],
  "attributes": {
    "dialogLabel": {
      "type": "string"
    },
    "inputLabel": {
      "type": "string"
    },
    "placeholder": {
      "type": "string"
    },
    "submitLabel": {
      "type": "string"
    },
    "closeLabel": {
      "type": "string"
    },
    "clearLabel": {
      "type": "string"
    },
    "noResultsLabel": {
      "type": "string"
    },
    "buttonTextColor": {
      "type": "string"
    },
    "buttonTextHoverColor": {
      "type": "string"
    },
    "buttonBackgroundColor": {
      "type": "string"
    },
    "buttonBackgroundHoverColor": {
      "type": "string"
    },
    "allResultsColor": {
      "type": "string"
    },
    "productsCount": {
      "type": "number"
    },
    "categoriesCount": {
      "type": "number"
    },
    "suggestionsCount": {
      "type": "number"
    },
    "showSku": {
      "type": "boolean",
      "default": true
    },
    "showCategory": {
      "type": "boolean",
      "default": true
    },
    "showBrand": {
      "type": "boolean",
      "default": true
    },
    "maxWidth": {
      "type": "number"
    }
  },
  "supports": {
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "html": false,
    "inserter": false,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css"
}