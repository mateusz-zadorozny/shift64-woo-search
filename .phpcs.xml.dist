<?xml version="1.0"?>
<ruleset name="Shift64 Woo Search Coding Standards">
	<description>Generally-applicable sniffs for WordPress plugins.</description>

	<!-- What to scan -->
	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/mu-plugins/</exclude-pattern>
	<!-- Generated dependency manifests intentionally follow wp-scripts naming and formatting. -->
	<exclude-pattern>/build/</exclude-pattern>

	<!-- How to scan -->
	<arg value="sp"/>
	<arg name="basepath" value="./"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- Rules: WordPress Coding Standards -->
	<config name="minimum_supported_wp_version" value="6.0"/>
	<rule ref="WordPress"/>

	<!-- Rules: PHP compatibility — enforce the declared PHP 8.3 minimum -->
	<config name="testVersion" value="8.3-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Disable Yoda conditions -->
	<rule ref="WordPress.PHP.YodaConditions">
		<severity>0</severity>
	</rule>

	<!-- Main plugin file must be named after the plugin, not the class -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>shift64-woo-search\.php</exclude-pattern>
	</rule>

	<!-- Main plugin file needs a function before the class for the WC dependency check -->
	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<exclude-pattern>shift64-woo-search\.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="shift64_woo_search"/>
				<element value="Shift64_Woo_Search"/>
				<element value="SHIFT64_WOO_SEARCH"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="shift64-woo-search"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
		<properties>
			<property name="blank_line_check" value="true"/>
		</properties>
	</rule>

	<!--
	Narrow exclusions for `bin/` and `tests/`.

	Both trees are scanned in full; the rules below are switched off only where a
	WordPress-runtime assumption does not hold. Each entry names a single error
	code — not a whole sniff — and a single tree, never a whole directory, so
	everything else (PHP compatibility, array and whitespace formatting, i18n,
	escaping, the security sniffs) still applies there.
	`tests/test-phpcs-ruleset-coverage.php` enforces both of those properties.
	-->

	<!-- Test method names are the documentation; a docblock per assertion adds noise. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>

	<!-- CLI entrypoints run in file scope, so their locals are not plugin globals. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/bin/</exclude-pattern>
	</rule>

	<!-- Same file scope: a CLI local shadowing a WP global never reaches WP core. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>/bin/</exclude-pattern>
	</rule>

	<!-- These scripts are invoked by path, so the class-file naming scheme does not apply. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>/bin/</exclude-pattern>
	</rule>

	<!-- A CLI entrypoint is a bootstrap plus its class; splitting it costs the single-file invocation. -->
	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<exclude-pattern>/bin/</exclude-pattern>
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>

	<!-- Reading a repo file off disk; wp_remote_get() is for URLs. -->
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>

	<!-- Writing to an already-open STDOUT/STDERR stream, not to the filesystem. -->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
		<exclude-pattern>/bin/</exclude-pattern>
	</rule>

	<!-- The demo generator seeds a PRNG so a run is reproducible; wp_rand() cannot be seeded. -->
	<rule ref="WordPress.WP.AlternativeFunctions.rand_seeding_mt_srand">
		<exclude-pattern>/bin/</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.rand_mt_rand">
		<exclude-pattern>/bin/</exclude-pattern>
	</rule>

	<!-- Exception messages go to a terminal, not to HTML. -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>/bin/</exclude-pattern>
	</rule>

	<!-- A must-use plugin fixture: WordPress loads it by the `.mu.php` suffix. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>/tests/e2e/</exclude-pattern>
	</rule>
</ruleset>
